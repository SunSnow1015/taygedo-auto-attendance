TAYGEDO_ACCOUNTS='[
  {
    "id": "main",
    "name": "主账号",
    "uid": "123456",
    "deviceId": "abcdef1234567890",
    "refreshToken": "your-refresh-token",
    "roleId": "optional-role-id",
    "roleName": "optional-role-name"
  }
]'
TAYGEDO_NOTIFICATION_URLS=
TAYGEDO_SERVERCHAN_SENDKEY=
TAYGEDO_MAX_RETRIES=3
TAYGEDO_PASSWORDS={"main":"your-password"}
TAYGEDO_CREDENTIAL_KEY=
TAYGEDO_CREDENTIAL_KEY_PATH=data/credential-key
TAYGEDO_UPDATED_ACCOUNTS_PATH=updated-accounts.json
TAYGEDO_ACCOUNT_STORE=env
# memory 状态存储不跨进程持久化，常驻定时模式下无法配合「今日去重」；需要去重请改为 file
TAYGEDO_STATE_STORE=memory
# Docker / 本地 CLI 常驻模式：每日固定时刻（上海时区，HH:MM），优先于 LOOP_SECONDS。
# 设置后进程常驻不退出，一次性命令请显式覆盖为空（TAYGEDO_RUN_AT=）
TAYGEDO_RUN_AT=
TAYGEDO_ACCOUNTS_KEY=TAYGEDO_ACCOUNTS
TAYGEDO_STATE_PREFIX=taygedo
TAYGEDO_ADMIN_TOKEN=
TAYGEDO_UPSTASH_REDIS_REST_URL=
TAYGEDO_UPSTASH_REDIS_REST_TOKEN=
